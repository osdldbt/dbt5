# Verify that flat files generated by multiple EGenLoader instances,
# each covering a subrange of customers, contain the same data as the
# flat files from a single instance covering every customer.  This is
# the property that makes parallel data generation and loading safe.
#
# The customer range is partitioned into instances of CHUNK customers
# (a multiple of the 1000-customer Load Unit); the final instance
# covers whatever remains.  Customer-partitioned tables are generated
# in customer order, so the instance files concatenated in customer
# order must be byte-identical to the single-instance file.  Fixed
# tables are only generated by the instance containing customer 1 and
# must be byte-identical to the single-instance files.
#
# Defaults are the minimum valid TPC-E configuration: 5000 customers,
# scale factor 500, 300 initial trade days.  CHUNK defaults to 3000 so
# the final instance is smaller than the others.  This generates two
# spec-minimum data sets (tens of gigabytes each); override ITD for
# smaller, non-conformant development runs.
#
# TPC-E Tools are built in the shunit2 temporary directory, so the
# egen tree in the source directory is never patched in place and
# everything is removed on exit.  Requires the egen submodule to be
# initialized; exits 77 (skip) otherwise.

TOTAL=${TOTAL:-5000}
SF=${SF:-500}
ITD=${ITD:-300}
CHUNK=${CHUNK:-3000}

TOPDIR=${TOPDIR:-$(dirname "${0}")/..}
DBT5_BUILD_EGEN=${DBT5_BUILD_EGEN:-$(command -v dbt5-build-egen)}
SETUP_ERROR=""

if [ ! -d "${TOPDIR}/egen/prj" ]; then
	echo "egen submodule not initialized, skipping"
	exit 77
fi

run_loader() {
	"${LOADER}" -i "${EGENDIR}/flat_in" -o "${1}" -l FLAT \
			-b "${2}" -c "${3}" -t "${TOTAL}" -f "${SF}" \
			-w "${ITD}" > "${1}.log" 2>&1
}

oneTimeSetUp() {
	EGENDIR="${SHUNIT_TMPDIR}/egen"
	cp -a "${TOPDIR}/egen" "${EGENDIR}"
	if ! sh "${DBT5_BUILD_EGEN}" \
			--include-dir="${TOPDIR}/src/include" \
			--patch-dir="${TOPDIR}/patches" \
			--source-dir="${TOPDIR}/src" \
			"${EGENDIR}" > "${SHUNIT_TMPDIR}/build-egen.log" 2>&1; then
		SETUP_ERROR="egen build failed: ${SHUNIT_TMPDIR}/build-egen.log"
		return
	fi
	LOADER="${EGENDIR}/bin/EGenLoader"

	WORK="${SHUNIT_TMPDIR}/data"

	# All EGenLoader runs write to separate directories and generate
	# deterministic data, so run them concurrently.
	mkdir -p "${WORK}/full"
	run_loader "${WORK}/full" 1 "${TOTAL}" &
	FULL_PID=$!

	CUSTOMER_START=1
	INSTANCES=0
	PIDS=""
	while [ "${CUSTOMER_START}" -le "${TOTAL}" ]; do
		COUNT=$(( TOTAL - CUSTOMER_START + 1 ))
		if [ "${COUNT}" -gt "${CHUNK}" ]; then
			COUNT=${CHUNK}
		fi
		INSTANCES=$(( INSTANCES + 1 ))
		# Zero-pad the directory names so instance globs sort in
		# customer order past nine instances.
		DIR="${WORK}/$(printf "instance%03d" "${INSTANCES}")"
		mkdir -p "${DIR}"
		run_loader "${DIR}" "${CUSTOMER_START}" "${COUNT}" &
		PIDS="${PIDS} $!:${INSTANCES}"
		CUSTOMER_START=$(( CUSTOMER_START + COUNT ))
	done

	if ! wait "${FULL_PID}"; then
		SETUP_ERROR="full EGenLoader run failed: ${WORK}/full.log"
	fi
	for ENTRY in ${PIDS}; do
		if ! wait "${ENTRY%:*}" && [ -z "${SETUP_ERROR}" ]; then
			SETUP_ERROR="EGenLoader instance ${ENTRY#*:} failed: see its log"
		fi
	done
}

check_setup() {
	if [ -n "${SETUP_ERROR}" ]; then
		fail "${SETUP_ERROR}"
		return 1
	fi
	return 0
}

check_partitioned_table() {
	check_setup || return
	cat "${WORK}"/instance*/"${1}.txt" | cmp -s - "${WORK}/full/${1}.txt"
	assertTrue "${1}: concatenated instances differ from full run" ${?}
}

check_fixed_table() {
	check_setup || return
	cmp -s "${WORK}/instance001/${1}.txt" "${WORK}/full/${1}.txt"
	assertTrue "${1}: instance 1 differs from full run" ${?}
}

test_fixed_tables_only_from_first_instance() {
	check_setup || return
	I=2
	while [ "${I}" -le "${INSTANCES}" ]; do
		DIR="${WORK}/$(printf "instance%03d" "${I}")"
		for T in ${FIXED_TABLES}; do
			assertFalse "${T}: generated by instance ${I}" \
					"[ -e '${DIR}/${T}.txt' ]"
		done
		I=$(( I + 1 ))
	done
}

PARTITIONED_TABLES="AccountPermission Address Broker CashTransaction
		Company CompanyCompetitor Customer CustomerAccount
		CustomerTaxrate DailyMarket Financial Holding HoldingHistory
		HoldingSummary LastTrade NewsItem NewsXRef Security Settlement
		Trade TradeHistory WatchItem WatchList"

FIXED_TABLES="Charge CommissionRate Exchange Industry Sector StatusType
		TaxRate TradeType ZipCode"

# Define one test per table so a failure names the table and the other
# tables are still checked and reported individually.
for T in ${PARTITIONED_TABLES}; do
	eval "test_concat_${T}() { check_partitioned_table ${T}; }"
done
for T in ${FIXED_TABLES}; do
	eval "test_fixed_${T}() { check_fixed_table ${T}; }"
done

# Tests defined with eval are not found by shunit2's automatic test
# discovery, so name every test explicitly.
suite() {
	for T in ${PARTITIONED_TABLES}; do
		suite_addTest "test_concat_${T}"
	done
	for T in ${FIXED_TABLES}; do
		suite_addTest "test_fixed_${T}"
	done
	suite_addTest test_fixed_tables_only_from_first_instance
}

. "${SHUNIT2:-shunit2}"
