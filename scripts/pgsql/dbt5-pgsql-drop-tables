# Drop tables, domains and sequence

# PSQL holds a command with its arguments, so every use of it has to
# word split.
# shellcheck disable=SC2086

while getopts "d:p:" OPT; do
	case ${OPT} in
	d)
		DBT5DBNAME=${OPTARG}
		;;
	p)
		PORT=${OPTARG}
		;;
	*)
		;;
	esac
done

if [ -z "${DBT5DBNAME}" ]; then
	echo "DBT5DBNAME not defined."
	exit 1
fi

if [ -n "${PORT}" ]; then
	PORTOPT="-p ${PORT}"
fi

PSQL="psql -X ${PORTOPT} -d ${DBT5DBNAME}"

${PSQL} -c "DROP TABLE IF EXISTS ACCOUNT_PERMISSION CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS CUSTOMER CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS CUSTOMER_ACCOUNT CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS CUSTOMER_TAXRATE CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS HOLDING CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS HOLDING_HISTORY CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS HOLDING_SUMMARY CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS WATCH_ITEM CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS WATCH_LIST CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS BROKER CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS CASH_TRANSACTION CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS CHARGE CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS COMMISSION_RATE CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS SETTLEMENT CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS TRADE CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS TRADE_HISTORY CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS TRADE_REQUEST CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS TRADE_TYPE CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS COMPANY CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS COMPANY_COMPETITOR CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS DAILY_MARKET CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS EXCHANGE CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS FINANCIAL CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS INDUSTRY CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS LAST_TRADE CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS NEWS_ITEM CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS NEWS_XREF CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS SECTOR CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS SECURITY CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS ADDRESS CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS STATUS_TYPE CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS TAXRATE CASCADE;"
${PSQL} -c "DROP TABLE IF EXISTS ZIP_CODE CASCADE;"

${PSQL} -c "DROP DOMAIN IF EXISTS S_COUNT_T CASCADE;"
${PSQL} -c "DROP DOMAIN IF EXISTS IDENT_T CASCADE;"
${PSQL} -c "DROP DOMAIN IF EXISTS TRADE_T CASCADE;"
${PSQL} -c "DROP DOMAIN IF EXISTS BALANCE_T CASCADE;"
${PSQL} -c "DROP DOMAIN IF EXISTS S_PRICE_T CASCADE;"
${PSQL} -c "DROP DOMAIN IF EXISTS S_QTY_T CASCADE;"
${PSQL} -c "DROP DOMAIN IF EXISTS VALUE_T CASCADE;"
${PSQL} -c "DROP DOMAIN IF EXISTS FIN_AGG_T CASCADE;"

${PSQL} -c "DROP SEQUENCE IF EXISTS seq_trade_id;"
