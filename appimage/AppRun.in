#!/bin/sh
@SHELLOPTIONS@

usage() {
	cat << EOF
Database Test 5 (DBT-5) wrapped up in an AppImage.
THE TPC SOFTWARE IS AVAILABLE WITHOUT CHARGE FROM TPC.

Usage:
  $(basename "${0}") COMMAND [OPTION]

Options:
  The OPTION choices are dependent on the COMMAND specified.  The -h flag will
  display the available options.

Help command:
  man   This COMMAND will display the man page for any of the general commands
        below when given as its OPTION.  (Note: man pages are not available for
        all available commands, yet.)

Commands:
$(find "${APPDIR}/usr/bin" -maxdepth 1 -type f -name "dbt5-*" -printf "%f\n" | sed -e "s/dbt5-/  /")


@HOMEPAGE@
EOF
}

if [ "${APPDIR}" = "" ]; then
	APPDIR="$(cd -- "$(dirname -- "${0}")" && pwd)"
	export APPDIR
fi

if [ $# -eq 0 ]; then
	usage
	exit 1
fi

VERBOSE=0
VERSION=0

# Custom argument handling for hopefully most portability.
while [ "${#}" -gt 0 ] ; do
	case "${1}" in
	(man)
		if [ "${MANPATH}" = "" ]; then
			export MANPATH="${APPDIR}/usr/share/man"
		else
			export MANPATH="${APPDIR}/usr/share/man:${MANPATH}"
		fi
		man "dbt5-${2}"
		exit $?
		;;
	(--verbose)
		VERBOSE=1
		;;
	(-V | --version)
		VERSION=1
		;;
	(-\? | --help)
		usage
		exit 0
		;;
	(--* | -*)
		echo "$(basename "${0}"): invalid option -- '${1}'"
		echo "try \"$(basename "${0}") --help\" for more information."
		exit 1
		;;
	(*)
		break
		;;
	esac
	shift
done

if [ $VERSION -eq 1 ]; then
	if [ $VERBOSE -eq 1 ]; then
		"${APPDIR}/usr/bin/dbt5" --version --verbose
		echo ""
		"${APPDIR}/usr/bin/dbt-version"
		echo ""
		"${APPDIR}/usr/bin/ts" --version
		# Where each cloned tool came from, written next to its license
		# at image build time.
		for SOURCE in "${APPDIR}"/usr/share/licenses/*/SOURCE; do
			[ -f "${SOURCE}" ] || continue
			echo ""
			echo "$(basename "$(dirname "${SOURCE}")") built from:"
			sed -e 's/^/  /' "${SOURCE}"
		done
	else
		"${APPDIR}/usr/bin/dbt5" --version
	fi
	exit 0
fi

# Save the caller's search paths before overriding them.  The bundled
# binaries need the AppImage's, but a command the user supplies through
# a config file is a host command and needs the environment it was
# written for.  See dbt5-test-db-parameter, which restores these around
# db_start_command and db_stop_command.
export DBT5_HOST_PATH="${PATH}"
export DBT5_HOST_LD_LIBRARY_PATH="${LD_LIBRARY_PATH}"

export PATH="${APPDIR}/usr/bin:${PATH}"

if [ "${LD_LIBRARY_PATH}" = "" ]; then
	export LD_LIBRARY_PATH="${APPDIR}/usr/lib"
else
	export LD_LIBRARY_PATH="${APPDIR}/usr/lib:${LD_LIBRARY_PATH}"
fi

export PERL5LIB="${APPDIR}/etc/perl"

COMMAND="${APPDIR}/usr/bin/dbt5-${1}"

if [ ! -f "$COMMAND" ]; then
	echo "COMMAND '${1}' not found, run '$(basename "${0}")' without arguments for usage."
	exit 1
fi

shift

$COMMAND "$@"
