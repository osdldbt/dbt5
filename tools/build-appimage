#!/bin/sh

if [ -n "${ENGINE:-}" ]; then
	CONTAINER_CMD="${ENGINE}"
elif command -v podman > /dev/null 2>&1; then
	CONTAINER_CMD="podman"
elif command -v docker > /dev/null 2>&1; then
	CONTAINER_CMD="docker"
else
	echo "podman or docker is not in your path"
	exit 1
fi

CONTAINER_DIR="$(dirname "$(realpath "${0}")")"
SRCDIR="$(cd "${CONTAINER_DIR}/.." && pwd)"
CONTAINER_TAG="dbt5-appimage"
TARGET="appimage"

# Use the return code from inspect to determine if the container image
# needs to be created.
if ! ${CONTAINER_CMD} inspect ${CONTAINER_TAG} > /dev/null 2>&1; then
	"${CONTAINER_DIR}/build-appimage-container" || exit 1
fi

if [ "${CONTAINER_CMD}" = "podman" ]; then
	USERNS_ARG="--userns=keep-id"
else
	USERNS_ARG=""
fi

# A linked worktree keeps its git metadata outside the source directory: .git
# is a file naming the directory that holds it.  Mount that directory at the
# same path it has here, so the version the build derives from git is the same
# one a build outside the container derives.  A plain clone keeps everything
# under the source directory, which is already mounted, and adds nothing.
set --
if [ -f "${SRCDIR}/.git" ]; then
	GITDIR="$(sed -n 's/^gitdir: //p' "${SRCDIR}/.git")"
	if [ -d "${GITDIR}" ]; then
		# commondir is relative to the directory holding it, and names the
		# repository the worktree belongs to.
		COMMONDIR="$(cd "${GITDIR}" &&
				cd "$(cat commondir 2> /dev/null || echo .)" &&
				pwd)"
		# Read-write: the worktree's index lives in this directory, and
		# the refresh of that index at configure time has to write.
		set -- -v "${COMMONDIR}:${COMMONDIR}:rw,Z"
	fi
fi

${CONTAINER_CMD} run \
		--rm \
		--user "$(id -u):$(id -g)" \
		${USERNS_ARG} \
		-v "${SRCDIR}:/dbt5:rw,Z" \
		"$@" \
		--env PKG_CONFIG_PATH="/usr/lib/pkgconfig" \
		-w /dbt5 \
		$CONTAINER_TAG \
		make ${TARGET}
